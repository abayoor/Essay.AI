{
  "name": "slipstream",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --use-system-ca ./node_modules/vite/bin/vite.js --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "db:login": "supabase login",
    "db:link": "supabase link",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "keep-awake:setup": "node --use-system-ca scripts/setup-keep-awake.mjs",
    "ai:check": "node --use-system-ca scripts/check-gemini.mjs",
    "ai:deploy": "supabase functions deploy ai --use-api",
    "ai:deploy:direct": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-ai-function.ps1",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capgo/background-geolocation": "^8.3.1",
    "@supabase/supabase-js": "^2.110.8",
    "@types/leaflet": "^1.9.21",
    "framer-motion": "^12.43.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.4",
    "supabase": "^2.110.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
}
